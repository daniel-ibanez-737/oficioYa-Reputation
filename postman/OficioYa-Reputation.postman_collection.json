                  "const uuid = () => pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('trabajadorId', uuid());",
                  "pm.collectionVariables.set('contratanteId', uuid());",
                  "pm.collectionVariables.set('solicitudA', uuid());",
                  "pm.collectionVariables.set('solicitudB', uuid());",
                  "pm.collectionVariables.set('solicitudCancelada', uuid());",
                  "pm.collectionVariables.set('hoy', new Date().toISOString().substring(0, 10));"
                ]
              }
            },
